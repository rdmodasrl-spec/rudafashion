generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountIdentity {
  id               String             @id
  email            String
  emailVerifiedAt  DateTime?
  phone            String?            @unique
  phoneVerifiedAt  DateTime?
  passwordHash     String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  scope            String             @default("public")
  AuthAccount      AuthAccount[]
  MerchantEmployee MerchantEmployee[]

  @@unique([scope, email])
  @@index([emailVerifiedAt])
  @@index([phoneVerifiedAt])
}

model AdminTwoFactor {
  id                String    @id
  adminAccountId    String    @unique
  secretEncrypted   String
  enabled           Boolean   @default(false)
  recoveryCodesHash String?
  lastVerifiedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime

  @@index([enabled])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeCreativeDraft {
  id                             String                         @id
  merchantId                     String
  installationId                 String
  productId                      String?
  prompt                         String                         @db.VarChar(1000)
  image                          Bytes
  imageMime                      String                         @default("image/webp") @db.VarChar(32)
  imageWidth                     Int
  imageHeight                    Int
  model                          String                         @db.VarChar(120)
  status                         String                         @default("pending_review") @db.VarChar(24)
  reviewedBy                     String?
  reviewedAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime
  MerchantAiEmployeeInstallation MerchantAiEmployeeInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  Merchant                       Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Product                        Product?                       @relation(fields: [productId], references: [id])

  @@index([installationId, status, createdAt])
  @@index([merchantId, status, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeDefinition {
  id                             String                           @id
  slug                           String                           @unique @db.VarChar(80)
  name                           String                           @db.VarChar(120)
  department                     String                           @db.VarChar(40)
  description                    String
  version                        String                           @default("0.1.0") @db.VarChar(32)
  status                         String                           @default("planned") @db.VarChar(24)
  capabilities                   String                           @default("[]")
  requiredPermissions            String                           @default("[]")
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime
  MerchantAiEmployeeInstallation MerchantAiEmployeeInstallation[]

  @@index([status, department])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeProductContentDraft {
  id                             String                         @id
  merchantId                     String
  installationId                 String
  productId                      String
  language                       String                         @db.VarChar(8)
  sourceTitle                    String?
  sourceDescription              String?
  title                          String                         @db.VarChar(120)
  description                    String
  status                         String                         @default("pending") @db.VarChar(24)
  reviewedBy                     String?
  reviewedAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime
  MerchantAiEmployeeInstallation MerchantAiEmployeeInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  Merchant                       Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Product                        Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([installationId, productId, language, status], map: "AiEmployeeProductContentDraft_installationId_productId_language")
  @@index([merchantId, status, createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AiEmployeeProductImportDraft {
  id                             String                         @id
  merchantId                     String
  installationId                 String
  sourceFilename                 String                         @db.VarChar(255)
  sourceType                     String                         @db.VarChar(16)
  extractedData                  String
  status                         String                         @default("pending") @db.VarChar(24)
  productId                      String?
  reviewedBy                     String?
  reviewedAt                     DateTime?
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime
  MerchantAiEmployeeInstallation MerchantAiEmployeeInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  Merchant                       Merchant                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Product                        Product?                       @relation(fields: [productId], references: [id])

  @@index([installationId, status, createdAt], map: "AiEmployeeProductImportDraft_installationId_status_createdAt_id")
  @@index([merchantId, status, createdAt])
}

model Appointment {
  id            String   @id
  appointmentNo String   @unique
  showroomId    String
  showroomName  String
  date          String
  time          String
  visitorCount  Int      @default(1)
  companyName   String
  contactPerson String
  phone         String
  email         String
  interests     String
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  Showroom      Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)

  @@index([appointmentNo])
  @@index([date])
  @@index([showroomId])
  @@index([status])
}

model AuditLog {
  id        String   @id
  userId    String
  userName  String
  role      String
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
  ip        String?

  @@index([entity, entityId])
  @@index([timestamp])
  @@index([userId])
}

model AuthAccount {
  id              String           @id
  role            String
  email           String?
  username        String?
  customerId      String?          @unique
  merchantId      String?          @unique
  merchantCode    String?          @unique
  passwordHash    String
  require2fa      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  lastLoginAt     DateTime?
  lastLoginIp     String?
  googleSub       String?          @unique
  permissions     String           @default("[]")
  companyId       String?
  preferences     String           @default("{}")
  phone           String?
  identityId      String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  Company         Company?         @relation(fields: [companyId], references: [id])
  AccountIdentity AccountIdentity? @relation(fields: [identityId], references: [id])

  @@unique([role, email])
  @@unique([role, phone])
  @@unique([role, username])
  @@index([companyId])
  @@index([customerId])
  @@index([emailVerifiedAt])
  @@index([email])
  @@index([googleSub])
  @@index([identityId])
  @@index([merchantCode])
  @@index([merchantId])
  @@index([role])
  @@index([username])
}

model Company {
  id                  String                @id
  legalName           String
  displayName         String
  vatNumber           String?               @unique
  registrationNumber  String?
  country             String
  city                String
  address             String                @default("")
  postalCode          String                @default("")
  website             String                @default("")
  status              String                @default("DRAFT")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  phone               String?               @unique
  AuthAccount         AuthAccount[]
  CompanyBusinessRole CompanyBusinessRole[]
  CompanyDocument     CompanyDocument[]
  CompanyVerification CompanyVerification?
  Customer            Customer[]
  Merchant            Merchant[]
  MerchantEmployee    MerchantEmployee[]

  @@index([country, city])
  @@index([status])
}

model CompanyBusinessRole {
  id        String   @id
  companyId String
  role      String
  status    String   @default("pending")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime
  Company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, role])
  @@index([companyId, status])
  @@index([role, status])
}

model CompanyDocument {
  id           String   @id
  companyId    String
  documentType String
  fileName     String
  mimeType     String
  fileSize     Int
  storageUrl   String
  status       String   @default("pending")
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  Company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, documentType])
  @@index([companyId, status])
}

model CompanyVerification {
  id              String    @id
  companyId       String    @unique
  status          String    @default("pending")
  riskLevel       String    @default("unknown")
  provider        String?
  providerRef     String?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  riskScore       Int       @default(0)
  Company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, riskLevel])
}

model ContactVerificationCode {
  id          String    @id
  destination String
  channel     String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([destination, channel, purpose, expiresAt], map: "ContactVerificationCode_destination_channel_purpose_expiresAt_i")
}

model CreditLedgerEntry {
  id           String   @id
  customerId   String
  orderId      String?
  entryType    String
  amount       Decimal  @db.Decimal(14, 2)
  balanceAfter Decimal  @db.Decimal(14, 2)
  note         String?
  operatorId   String?
  createdAt    DateTime @default(now())

  @@index([customerId, createdAt])
  @@index([entryType])
  @@index([orderId])
}

model Customer {
  id                   String                 @id
  companyName          String
  vatNumber            String
  address              String
  city                 String
  country              String
  contactPerson        String
  phone                String
  email                String
  businessType         String                 @default("Boutique")
  websiteOrSocial      String                 @default("")
  status               String                 @default("pending")
  tier                 String                 @default("tier_standard")
  creditLimit          Decimal                @default(0) @db.Decimal(12, 2)
  usedCredit           Decimal                @default(0) @db.Decimal(12, 2)
  discountRate         Decimal                @default(1.0) @db.Decimal(5, 4)
  registrationDate     String
  approvedAt           String?
  ordersCount          Int                    @default(0)
  totalSpent           Decimal                @default(0) @db.Decimal(14, 2)
  onboardingStatus     String                 @default("document_check")
  documents            String?
  paymentSlips         String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  companyId            String?
  customerLevel        String                 @default("new_customer")
  Company              Company?               @relation(fields: [companyId], references: [id])
  MerchantAiOrderDraft MerchantAiOrderDraft[]
  MerchantCustomerLink MerchantCustomerLink[]
  Order                Order[]
  OrderInvoice         OrderInvoice[]
  ReturnRequest        ReturnRequest[]
  SalesQuote           SalesQuote[]
  VaultAccessRequest   VaultAccessRequest[]

  @@index([companyId])
  @@index([country])
  @@index([email])
  @@index([status])
  @@index([tier])
  @@index([vatNumber])
}

model EmailVerificationCode {
  id         String    @id
  email      String
  codeHash   String
  purpose    String    @default("quick_buyer_registration")
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, expiresAt])
}

model EmployeeAuditLog {
  id               String            @id
  merchantId       String
  employeeId       String?
  action           String
  entityType       String
  entityId         String?
  metadata         String?
  ipAddress        String?
  createdAt        DateTime          @default(now())
  MerchantEmployee MerchantEmployee? @relation(fields: [employeeId], references: [id])
  Merchant         Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@index([entityType, entityId])
  @@index([merchantId, createdAt])
}

model FashionCommunityComment {
  id                   String                @id
  contentId            String
  postId               String?
  viewerId             String
  displayName          String
  text                 String
  createdAt            DateTime
  FashionCommunityPost FashionCommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([postId])
}

model FashionCommunityFollow {
  id        String   @id
  creatorId String
  viewerId  String
  createdAt DateTime @default(now())

  @@unique([creatorId, viewerId])
  @@index([creatorId])
  @@index([viewerId])
}

model FashionCommunityPost {
  id                       String                     @id
  image                    String
  merchantId               String
  merchantName             String
  createdAt                DateTime
  featured                 Boolean                    @default(false)
  title                    String?
  caption                  String?
  category                 String?
  mediaType                String                     @default("image")
  videoUrl                 String?
  videoStorageKey          String?
  imageStorageKey          String?
  posterStorageKey         String?
  rightsStatus             String                     @default("authorized")
  publicationStatus        String                     @default("pending")
  engagementScore          Int                        @default(0)
  updatedAt                DateTime
  FashionCommunityComment  FashionCommunityComment[]
  FashionCommunityReaction FashionCommunityReaction[]

  @@index([merchantId, createdAt])
  @@index([publicationStatus, createdAt, id])
  @@index([publicationStatus, engagementScore, createdAt, id], map: "FashionCommunityPost_publicationStatus_engagementScore_createdA")
}

model FashionCommunityReaction {
  id                   String                @id
  contentId            String
  postId               String?
  viewerId             String
  reaction             String
  createdAt            DateTime              @default(now())
  FashionCommunityPost FashionCommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([contentId, viewerId, reaction])
  @@index([contentId, reaction])
  @@index([postId, reaction])
  @@index([viewerId, reaction])
}

model FulfillmentShipment {
  id                      String                    @id
  orderId                 String
  shipmentNo              String
  carrier                 String?
  trackingNumber          String?
  status                  String
  shippedAt               DateTime?
  deliveredAt             DateTime?
  proofOfDelivery         String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  FulfillmentShipmentItem FulfillmentShipmentItem[]
  ShipmentTrackingEvent   ShipmentTrackingEvent[]

  @@unique([orderId, shipmentNo])
  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
}

model FulfillmentShipmentItem {
  id                  String              @id
  shipmentId          String
  orderItemId         String
  quantity            Int
  createdAt           DateTime            @default(now())
  OrderItem           OrderItem           @relation(fields: [orderItemId], references: [id])
  FulfillmentShipment FulfillmentShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([orderItemId])
}

model InventoryBalance {
  id                String            @id
  merchantId        String?
  variantId         String
  locationId        String
  onHandQuantity    Int               @default(0)
  reservedQuantity  Int               @default(0)
  inTransitQuantity Int               @default(0)
  version           Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  WarehouseLocation WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Merchant          Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ProductVariant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, locationId])
  @@index([merchantId, locationId])
  @@index([variantId])
}

model InventoryMovement {
  id                String            @id
  merchantId        String?
  variantId         String
  locationId        String
  quantity          Int
  movementType      String
  referenceType     String?
  referenceId       String?
  idempotencyKey    String?           @unique
  operatorId        String?
  note              String?
  createdAt         DateTime          @default(now())
  WarehouseLocation WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Merchant          Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ProductVariant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@index([movementType, createdAt])
  @@index([referenceType, referenceId])
  @@index([variantId, locationId, createdAt])
}

model Material {
  id                        String                      @id
  merchantId                String
  supplierId                String?
  code                      String
  name                      String
  category                  String
  unit                      String                      @default("meter")
  unitCost                  Decimal                     @default(0) @db.Decimal(12, 4)
  reorderPoint              Decimal                     @default(0) @db.Decimal(14, 3)
  leadTimeDays              Int                         @default(0)
  status                    String                      @default("active")
  notes                     String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  Merchant                  Merchant                    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Supplier                  Supplier?                   @relation(fields: [supplierId], references: [id])
  MaterialInventoryBalance  MaterialInventoryBalance[]
  MaterialInventoryMovement MaterialInventoryMovement[]
  ProductBomItem            ProductBomItem[]

  @@unique([merchantId, code])
  @@index([merchantId, category, status])
  @@index([supplierId])
}

model MaterialInventoryBalance {
  id                String            @id
  merchantId        String
  materialId        String
  locationId        String
  onHandQuantity    Decimal           @default(0) @db.Decimal(14, 3)
  reservedQuantity  Decimal           @default(0) @db.Decimal(14, 3)
  version           Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime
  WarehouseLocation WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Material          Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, locationId])
  @@index([merchantId, locationId])
}

model MaterialInventoryMovement {
  id                String            @id
  merchantId        String
  materialId        String
  locationId        String
  quantity          Decimal           @db.Decimal(14, 3)
  movementType      String
  referenceType     String?
  referenceId       String?
  idempotencyKey    String?           @unique
  operatorId        String?
  note              String?
  createdAt         DateTime          @default(now())
  WarehouseLocation WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  Material          Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, locationId, createdAt])
  @@index([merchantId, createdAt])
  @@index([referenceType, referenceId])
}

