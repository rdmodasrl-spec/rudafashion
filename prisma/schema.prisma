/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MerchantAiEmployeeInstallation {
  id                            String                          @id
  merchantId                    String
  definitionId                  String
  status                        String                          @default("active") @db.VarChar(24)
  grantedPermissions            String                          @default("[]")
  installedBy                   String?
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime
  AiEmployeeCreativeDraft       AiEmployeeCreativeDraft[]
  AiEmployeeProductContentDraft AiEmployeeProductContentDraft[]
  AiEmployeeProductImportDraft  AiEmployeeProductImportDraft[]
  AiEmployeeDefinition          AiEmployeeDefinition            @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  Merchant                      Merchant                        @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, definitionId])
  @@index([definitionId, status])
  @@index([merchantId, status, createdAt])
}

model MerchantAiEmployeeMemory {
  id                 String    @id
  merchantId         String
  category           String    @db.VarChar(24)
  content            String    @db.VarChar(500)
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  tenantId           String
  scope              String    @default("MERCHANT") @db.VarChar(24)
  memoryType         String    @default("preference") @db.VarChar(32)
  status             String    @default("active") @db.VarChar(24)
  importance         Float     @default(0.5)
  confidence         Float     @default(0.5)
  source             String    @default("USER") @db.VarChar(24)
  sourceRef          String?   @db.VarChar(160)
  verificationStatus String    @default("unverified") @db.VarChar(24)
  version            Int       @default(1)
  expiresAt          DateTime?
  validFrom          DateTime?
  validUntil         DateTime?
  lastVerifiedAt     DateTime?
  lastAccessedAt     DateTime?
  accessCount        Int       @default(0)
  Merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, category, updatedAt])
  @@index([tenantId, merchantId, scope, status, updatedAt])
}

model MerchantAiOrderDraft {
  id            String      @id
