  currency              String?               @db.VarChar(3)
  MerchantAiOrderDraft  MerchantAiOrderDraft?
  Customer              Customer              @relation(fields: [customerId], references: [id])
  Merchant              Merchant              @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  SalesQuoteItem        SalesQuoteItem[]

  @@index([customerId, createdAt])
  @@index([merchantId, status, createdAt])
}

model SalesQuoteItem {
  id                String     @id
  quoteId           String
  productId         String
  sku               String
  styleNo           String
  productName       String
  color             String
  size              String
  quantity          Int
  unitPrice         Decimal    @db.Decimal(10, 2)
  approvalRequestId String?
  SalesQuote        SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([productId, sku])
  @@index([quoteId])
}

model ShipmentTrackingEvent {
  id                  String              @id
  shipmentId          String
  status              String
  location            String?
  description         String?
  occurredAt          DateTime
  createdAt           DateTime            @default(now())
  FulfillmentShipment FulfillmentShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model Showroom {
  id              String        @id
  name            String
  code            String        @unique
  city            String
  city_it         String?
  city_zh         String?
  address         String
  phone           String
  email           String
  openingHours    String
  openingHours_it String?
  openingHours_zh String?
  capacity        String
  capacity_it     String?
  capacity_zh     String?
  image           String
  features        String
  features_it     String?
  features_zh     String?
  Appointment     Appointment[]

  @@index([city])
  @@index([code])
}

model SolanaPaymentIntent {
  id                     String    @id
  orderId                String    @unique
  merchantId             String
  reference              String    @unique @db.VarChar(64)
  requestTokenHash       String    @unique @db.VarChar(64)
  requestTokenEncrypted  String
  recipient              String    @db.VarChar(64)
  platformWallet         String    @db.VarChar(64)
  mint                   String    @db.VarChar(64)
  tokenSymbol            String    @db.VarChar(8)
  eurAmount              Decimal   @db.Decimal(14, 2)
  exchangeRate           Decimal   @db.Decimal(20, 10)
  exchangeRateSource     String    @db.VarChar(64)
  exchangeRateUpdatedAt  DateTime
  tokenAmount            Decimal   @db.Decimal(20, 6)
  amountAtomic           String    @db.VarChar(24)
  commissionRate         Decimal   @db.Decimal(5, 4)
  merchantAmount         Decimal   @db.Decimal(20, 6)
  merchantAmountAtomic   String    @db.VarChar(24)
  commissionAmount       Decimal   @db.Decimal(20, 6)
  commissionAmountAtomic String    @db.VarChar(24)
  quotedAt               DateTime
  expiresAt              DateTime
  status                 String    @default("pending")
  signature              String?   @unique @db.VarChar(128)
  lastCheckedAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime
  Merchant               Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Order                  Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([merchantId, status, expiresAt])
  @@index([status, expiresAt])
}

model StockMovement {
  id           String   @id
  productId    String
  sku          String
  location     String
  quantity     Int
  movementType String
  referenceId  String?
  operatorId   String?
  note         String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([location])
  @@index([movementType])
  @@index([productId, sku])
  @@index([referenceId])
}

model StockReservation {
  id        String    @id
  orderId   String
  productId String
  sku       String
  location  String
  quantity  Int
  status    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime

  @@index([orderId])
  @@index([productId, sku])
  @@index([status])
}

model StockTransfer {
  id             String    @id
  transferNo     String?   @unique
  date           String
  fromLocation   String
  toLocation     String
  styleNo        String
  sku            String
  quantity       Int
  status         String
  operator       String
  merchantId     String?
  notes          String?
  createdAt      DateTime  @default(now())
  idempotencyKey String?   @unique
  Merchant       Merchant? @relation(fields: [merchantId], references: [id])

  @@index([date])
  @@index([merchantId])
  @@index([status])
  @@index([transferNo])
}

model Supplier {
  id                    String                  @id
  merchantId            String
  name                  String
  contactName           String?
  phone                 String?
  email                 String?
  country               String?
  leadTimeDays          Int                     @default(0)
  status                String                  @default("active")
  notes                 String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  Material              Material[]
  MerchantPurchaseOrder MerchantPurchaseOrder[]
  Merchant              Merchant                @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, name])
  @@index([merchantId, status])
}

model SupportRequest {
  id                      String    @id
  name                    String
  email                   String?
  phone                   String?
  subject                 String
  message                 String
  status                  String    @default("open")
  adminReply              String?
  repliedAt               DateTime?
  repliedBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  internalNote            String?
  internalNoteUpdatedAt   DateTime?
  internalNoteUpdatedBy   String?
  customerReply           String?
  replyDeliveryStatus     String    @default("not_sent")
  replyAttemptedAt        DateTime?
  replyAttemptedBy        String?
  replyProviderAcceptedAt DateTime?
  replyProviderAcceptedBy String?
  replyDeliveryError      String?

  @@index([email])
  @@index([phone])
  @@index([status, createdAt])
}

model VaultAccessRequest {
  id             String   @id
  merchantId     String
  merchantName   String
  customerId     String
  companyName    String
  contactPerson  String
  phone          String
  businessType   String
  note           String?
  status         String
  appliedAt      String
  reviewedAt     String?
  approvedBy     String?
  expiresAt      String?
  accessLogCount Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  Customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([merchantId])
  @@index([status])
}

model WarehouseLocation {
  id                        String                      @id
  merchantId                String?
  code                      String
  name                      String
  type                      String
  country                   String?
  city                      String?
  isActive                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  InventoryBalance          InventoryBalance[]
  InventoryMovement         InventoryMovement[]
  MaterialInventoryBalance  MaterialInventoryBalance[]
  MaterialInventoryMovement MaterialInventoryMovement[]
  ProductionWorkOrder       ProductionWorkOrder[]
  Merchant                  Merchant?                   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, code])
  @@index([merchantId])
  @@index([type, isActive])
}
